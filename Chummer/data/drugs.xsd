<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="NewDataSet" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
  <xs:include schemaLocation="bonuses.xsd" />
  <xs:element name="chummer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="grades" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="grade" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="id" type="xs:string" minOccurs="1" maxOccurs="1" />
                    <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="ignoresourcedisabled" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="name" type="xs:string" minOccurs="0" />
                    <xs:element name="ess" type="xs:string" minOccurs="0" />
                    <xs:element name="cost" type="xs:string" minOccurs="0" />
                    <xs:element name="addictionthreshold" type="xs:integer" minOccurs="0" />
                    <xs:element name="avail" type="xs:string" minOccurs="0" />
                    <xs:element name="source" type="xs:string" minOccurs="0" />
                    <xs:element name="page" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="drugs" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="drug" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="id" type="xs:string" minOccurs="1" maxOccurs="1" />
                    <xs:element name="name" type="xs:string" minOccurs="1" maxOccurs="1" />
                    <xs:element name="category" type="xs:string" minOccurs="1" maxOccurs="1" />
                    <xs:element name="rating" type="xs:integer" minOccurs="0" maxOccurs="1" />
                    <xs:element name="threshold" type="xs:integer" minOccurs="0" maxOccurs="1" />
                    <xs:element name="source" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="page" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="avail" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="cost" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="speed" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="vectors" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="duration" type="xs:string" minOccurs="0" maxOccurs="1" />
                    <xs:element name="bonus" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                          <xs:any namespace="##any" processContents="lax" />
                        </xs:choice>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
